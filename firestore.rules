rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Jeder eingeloggte Spieler darf NUR seinen eigenen Spielstand lesen/schreiben
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Der Shop ist EIN geteiltes Dokument für alle Spieler.
    // Jeder eingeloggte Spieler darf es lesen und (per Transaktion) aktualisieren,
    // z.B. beim Kauf eines Eis oder beim Auslösen einer Rotation.
    match /shop/current {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Trading (siehe trading.js): läuft ohne Login, nur über einen zufälligen
    // Code als Dokument-ID. Ohne request.auth kann hier keine echte
    // Ownership-Prüfung stattfinden - wer den Code kennt, kann technisch
    // jedes Feld schreiben. Diese Regeln prüfen deshalb nur, dass ein
    // Dokument überhaupt die erwartete Form hat (Ehrensystem, kein Schutz
    // vor einem absichtlich manipulierten Client).
    // "get" (ein bekannter Code) ist erlaubt, "list" (alle Trades
    // durchsuchen) bewusst nicht - sonst könnte man fremde offene Trades
    // erraten/abgreifen, ohne den Code zu kennen.
    match /trades/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if isValidTrade(request.resource.data);
      allow update: if isValidTrade(request.resource.data)
                    && request.resource.data.code == resource.data.code
                    && request.resource.data.createdAtMs == resource.data.createdAtMs;
      allow delete: if false;
    }

    function isValidTrade(data) {
      return data.keys().hasAll(["code", "createdAtMs", "expiresAtMs", "status", "host", "guest"])
        && data.status in ["open", "completed", "cancelled"]
        && isValidTradeSide(data.host)
        && isValidTradeSide(data.guest);
    }

    function isValidTradeSide(side) {
      return side is map
        && side.keys().hasAll(["playerId", "name", "offer", "ready"])
        && (side.playerId == null || side.playerId is string)
        && (side.name == null || side.name is string)
        && side.ready is bool
        && isValidTradeOffer(side.offer);
    }

    function isValidTradeOffer(offer) {
      return offer is map
        && offer.keys().hasAll(["pets", "eggs", "coins"])
        && offer.pets is list && offer.pets.size() <= 20
        && offer.eggs is list && offer.eggs.size() <= 20
        && offer.coins is number && offer.coins >= 0 && offer.coins <= 1000000000000000000;
    }

    // Echtes Wetter (siehe weather.js): EIN geteiltes Dokument für alle
    // Spieler, alle 15 Minuten von irgendeinem gerade aktiven Client
    // aktualisiert. Ohne request.auth wieder nur eine Form-Prüfung, kein
    // echter Schutz vor einem manipulierten Client (Ehrensystem wie beim
    // Trading) - wer will, könnte sich hier ein Dauer-Regen-Wetter
    // einschreiben. Der Schaden davon ist überschaubar (nur kosmetisch +
    // etwas höhere Mutations-Chance für alle), daher bewusst kein größerer
    // Aufwand hier.
    match /weather/current {
      allow read: if true;
      allow write: if isValidWeather(request.resource.data);
    }

    function isValidWeather(data) {
      return data.keys().hasAll(["condition", "isDay", "fetchedAtMs", "validUntilMs"])
        && data.condition in ["sonne", "regen", "schnee", "windig"]
        && data.isDay is bool
        && data.fetchedAtMs is number
        && data.validUntilMs is number;
    }

    // Online-Rangliste (siehe leaderboard.js): läuft ohne Login, Dokument-ID
    // ist eine zufällige, lokal generierte Spieler-ID. "list" muss erlaubt
    // sein (nicht nur "get"), weil fetchLeaderboard eine Top-N-Query über die
    // ganze Collection macht, um die Bestenliste für alle anzuzeigen.
    // "delete" wird gebraucht, wenn ein Spieler den Admin-/Testmodus aktiviert
    // (der eigene Eintrag wird dann entfernt, siehe deleteScore).
    match /leaderboard/{id} {
      allow read: if true;
      allow write: if isValidLeaderboardEntry(request.resource.data);
      allow delete: if true;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(["name", "moneyPerSec", "updatedAtMs"])
        && data.name is string && data.name.size() <= 20
        && data.moneyPerSec is number && data.moneyPerSec >= 0
        && data.updatedAtMs is number;
    }
  }
}
